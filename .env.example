# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The first two values are PUBLIC by design: the publishable/anon key ships
# inside the client JavaScript of every Supabase site. The payment values
# further down are SECRET: they live only here (gitignored) and in Vercel's
# environment variables, never anywhere under public/.
#
# Supabase → Project Settings → API. New projects issue "sb_publishable_..."
# keys; older ones issue a long JWT. Either works.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# api/prompt.mjs also accepts NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, so values copied straight out of the
# Supabase dashboard work without being renamed.

# --- payments (api/payment-webhook.mjs) — see SETUP.md section 7 ----------
# Supabase → Project Settings → API Keys → a secret key (sb_secret_...) or the
# legacy service_role key. Only the webhook uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Polar → Settings → Webhooks → your endpoint → secret (whsec_...).
POLAR_WEBHOOK_SECRET=
# Polar product id = tier, comma-separated. Tiers: monthly, pro, team.
POLAR_PRODUCT_TIERS=
